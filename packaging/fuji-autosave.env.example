# /etc/fuji-autosave/env  (root:fuji, mode 640)
# Read by scripts/immich-hook. Plain KEY=value lines; values already in the
# environment win.

IMMICH_URL=http://immich.lan:2283
IMMICH_API_KEY=replace-me
# External library UUID (Administration → External Libraries, or GET /api/libraries)
LIBRARY_ID=00000000-0000-0000-0000-000000000000

# The library root as immich-server sees it (the library's import path)
PHOTO_ROOT_CONTAINER=/mnt/fuji
# ...and as this container sees it. Defaults to the daemon's --inbox, else
# /fuji; set it only if you mount the dataset somewhere else
#PHOTO_ROOT_HOST=/fuji

RAW_ALBUM_NAME="Fuji RAW"
# Each file is tagged "<prefix><camera model>", e.g. "Camera/X-T30 II". The
# model comes from the camera (and from EXIF for files from earlier runs)
CAMERA_TAG_PREFIX="Camera/"
# Or one fixed tag for everything instead:
#CAMERA_TAG="Fuji"
# stack: JPEG+RAF stacked, JPEG on top. archive: paired RAFs archived instead
RAW_MODE=stack
# Seconds to wait for Immich to index a batch before leaving it for the next run
SCAN_TIMEOUT=900
# Delete the file (and its darktable .xmp) once a photo is permanently deleted
# in Immich (after its trash), so the next scan doesn't import it again.
# 0 = never delete. More than DELETE_LIMIT in one run stops the hook instead.
DELETE_REMOVED=1
DELETE_LIMIT=50
