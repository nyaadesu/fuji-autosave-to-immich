# /etc/fuji-autosave/env  (root:fuji, mode 640)
# Read by scripts/immich-hook. Plain KEY=value lines, sourced by /bin/sh.

IMMICH_INSTANCE_URL=http://immich.lan:2283/api
IMMICH_API_KEY=replace-me
FUJI_IMMICH_ALBUM="Fuji X-T30 II"

# Must match the daemon's --inbox (FUJI_INBOX in /etc/conf.d/fuji-autosave)
FUJI_INBOX=/srv/fuji-inbox
# Uploaded files move here; set FUJI_KEEP_FILES=1 to leave them in the inbox
FUJI_ARCHIVE_DIR=/srv/fuji-inbox/archive
