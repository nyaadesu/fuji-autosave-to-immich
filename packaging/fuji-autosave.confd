# /etc/conf.d/fuji-autosave
# Daemon options. Immich settings live in /etc/fuji-autosave/env.

# Name the camera shows in its PC AutoSave list (1-24 characters)
#FUJI_CLIENT_NAME=fuji-inbox
# The Immich external library root, bind-mounted into this container
#FUJI_INBOX=/fuji
#FUJI_STATE_DIR=/var/lib/fuji-autosave
#FUJI_USER=fuji
# 002 makes new folders and files group-writable, so an SMB editing group can
# add darktable/Lightroom sidecars next to the RAFs
#FUJI_UMASK=022
# Set empty to only receive files, without the Immich scan/tag/stack/album step
#FUJI_HOOK=/usr/local/lib/fuji-autosave/immich-hook
# e.g. --verbose
#FUJI_EXTRA_ARGS=
