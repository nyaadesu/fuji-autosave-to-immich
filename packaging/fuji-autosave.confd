# /etc/conf.d/fuji-autosave
# Daemon options. Immich settings live in /etc/fuji-autosave/env.

# Name the camera shows in its PC AutoSave list (1-24 characters)
#FUJI_CLIENT_NAME=fuji-inbox
#FUJI_INBOX=/srv/fuji-inbox
#FUJI_STATE_DIR=/var/lib/fuji-autosave
#FUJI_USER=fuji
# Set empty to run without the Immich upload (e.g. with an external library)
#FUJI_HOOK=/usr/local/lib/fuji-autosave/immich-hook
# e.g. --verbose
#FUJI_EXTRA_ARGS=
