#!/sbin/openrc-run
# /etc/init.d/fuji-autosave

description="FUJIFILM PC AutoSave receiver"

: "${FUJI_USER:=fuji}"
: "${FUJI_INBOX:=/fuji}"
: "${FUJI_STATE_DIR:=/var/lib/fuji-autosave}"
: "${FUJI_CLIENT_NAME:=fuji-inbox}"
: "${FUJI_UMASK:=022}"
: "${FUJI_HOOK=/usr/local/lib/fuji-autosave/immich-hook}"

supervisor=supervise-daemon
command=/usr/local/bin/fuji-autosave-receiver
command_args="--inbox $FUJI_INBOX --state-dir $FUJI_STATE_DIR --name $FUJI_CLIENT_NAME ${FUJI_HOOK:+--hook $FUJI_HOOK} $FUJI_EXTRA_ARGS"
command_user="$FUJI_USER:$FUJI_USER"
umask=$FUJI_UMASK
respawn_delay=10
respawn_max=0
output_logger="logger -t fuji-autosave -p daemon.info"
error_logger="logger -t fuji-autosave -p daemon.info"
# A running hook (waiting for an Immich scan) is allowed to finish on stop
retry="TERM/300/KILL/5"
supervise_daemon_args="--env FUJI_ENV_FILE=/etc/fuji-autosave/env --env HOME=$FUJI_STATE_DIR"

depend() {
	need net localmount
	after firewall
	use logger
}

start_pre() {
	checkpath -d -m 0750 -o "$FUJI_USER:$FUJI_USER" "$FUJI_STATE_DIR"
	# The library root is a bind mount; only check it, never chown it
	if [ ! -d "$FUJI_INBOX" ] || ! su -s /bin/sh -c "test -w '$FUJI_INBOX'" "$FUJI_USER"; then
		eerror "$FUJI_INBOX is missing or not writable by $FUJI_USER (bind mount and ownership, see docs/deploy-lxc.md)"
		return 1
	fi
	if ! mountpoint -q "$FUJI_INBOX"; then
		ewarn "$FUJI_INBOX is not a mount point: is the data2/fuji bind mount missing? Files would stay in this container"
	fi
}
