#!/usr/bin/env python3
"""Post-batch hook for fuji-autosave-receiver: Immich external library flow.

The receiver writes straight into the external library root
(PHOTO_ROOT_HOST, e.g. /fuji/YYYY/YYYY-MM-DD/DSCF1234.RAF). This hook:

  1. deletes files whose photo was permanently deleted in Immich (see below),
  2. asks Immich to scan the library,
  3. waits until every file of the pending batches has an asset,
  4. tags each asset with its camera, "Camera/<model>",
  5. stacks each JPEG+RAF pair (JPEG as cover), or with RAW_MODE=archive
     archives the paired RAF instead,
  6. adds each RAF to the RAW_ALBUM_NAME album,
  7. keeps the rating and favorite of each JPEG+RAF pair the same (see below),
  8. logs a summary.

Steps 4-7 look at the whole library, so anything an earlier run missed (scan
timeout, Immich down) is caught up, but each step is done only once per file:
$FUJI_STATE_DIR/library.json records what was done, so unstacking a pair,
removing a RAF from the album, untagging or unarchiving in Immich sticks.
A batch list stays queued in $FUJI_STATE_DIR/batches/ until all its files
were found.

Deleting: Immich can't delete files of a read-only external library, so a
photo deleted there would come back with the next scan. Once Immich has
deleted it for good (emptied from the trash; a trashed photo is left alone),
the hook deletes the file and its darktable sidecar (<file>.xmp). Only files
whose asset the hook has recorded before are deleted, never more than
DELETE_LIMIT per run or more than half the library, and nothing if Immich
lists no assets at all; a run that would is stopped with an error instead.
(With a read-write mount Immich deletes the file itself; this is the fallback.)

Pairs: Immich is where photos are rated, darktable reads the rating from the
RAF's sidecar (Immich writes <file>.xmp when a rating changes). The stack
cover is the JPEG, so a rating or favorite set on one file of a pair is
copied to the other: whichever changed since the last run wins, the JPEG if
both did; the first time, the one that is set.

--sync runs steps 1 and 4-7 without a scan or batch processing; the
container runs it every SYNC_INTERVAL seconds. It skips while another run
holds the lock and logs only what it changed, and errors.

Settings come from the environment and from $FUJI_ENV_FILE
(default /etc/fuji-autosave/env; see packaging/fuji-autosave.env.example):
  IMMICH_URL            e.g. http://immich.lan:2283 (a trailing /api is fine)
  IMMICH_API_KEY        API key of the library's owner
  LIBRARY_ID            external library UUID
  PHOTO_ROOT_HOST       library root as this hook sees it (default $FUJI_INBOX,
                        else /fuji)
  PHOTO_ROOT_CONTAINER  the same root as Immich sees it (e.g. /mnt/fuji)
  RAW_ALBUM_NAME        default "Fuji RAW"
  CAMERA_TAG_PREFIX     default "Camera/"; the tag is prefix + camera model,
                        taken from the asset's EXIF Model, or for files of
                        this batch whose EXIF Immich hasn't read yet, from the
                        model the camera reported (FUJI_CAMERA_MODEL)
  CAMERA_TAG            one fixed tag for every asset instead (optional)
  RAW_MODE              stack (default) or archive
  SCAN_TIMEOUT          seconds to wait for new assets (default 900)
  DELETE_REMOVED        1 (default): delete files deleted in Immich; 0: never
  DELETE_LIMIT          most files deleted in one run (default 50)

Set by the receiver: FUJI_STATE_DIR, FUJI_INBOX, FUJI_BATCH_*, FUJI_CAMERA_*.
Run it by hand as the service user to retry pending batches, with --check
to test the settings and the API key, or with --sync as above.
"""
import fcntl
import glob
import json
import os
import posixpath
import sys
import time
import urllib.error
import urllib.request

JPEG_EXTS = {".jpg", ".jpeg"}
RAW_EXTS = {".raf"}
PAGE_SIZE = 1000
CHUNK = 500
MIN_VERSION = (3, 2, 0)  # structured search filters and cursors


def log(msg):
    print(f"immich-hook: {msg}", file=sys.stderr, flush=True)


class Fail(Exception):
    pass


def load_env_file(path):
    """KEY=value lines as written for /bin/sh; values already in os.environ win."""
    try:
        f = open(path)
    except OSError:
        return
    with f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            if key.startswith("export "):
                key = key[7:].strip()
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            elif " #" in value:
                # As in sh: an unquoted " #" starts a comment
                value = value.split(" #", 1)[0].rstrip()
            os.environ.setdefault(key, value)


def number(env, key, default, kind=float):
    try:
        return kind(env.get(key) or default)
    except ValueError:
        raise Fail(f"{key} must be a number, not {env[key]!r}") from None


def config():
    load_env_file(os.environ.get("FUJI_ENV_FILE", "/etc/fuji-autosave/env"))
    env = os.environ
    missing = [k for k in ("IMMICH_URL", "IMMICH_API_KEY", "LIBRARY_ID", "PHOTO_ROOT_CONTAINER") if not env.get(k)]
    host_root = env.get("PHOTO_ROOT_HOST") or env.get("FUJI_INBOX") or "/fuji"
    if missing:
        raise Fail("not set: " + ", ".join(missing))
    url = env["IMMICH_URL"].rstrip("/")
    if url.endswith("/api"):
        url = url[:-4]
    mode = env.get("RAW_MODE", "stack")
    if mode not in ("stack", "archive"):
        raise Fail(f"RAW_MODE must be stack or archive, not {mode!r}")
    delete = env.get("DELETE_REMOVED", "1")
    if delete not in ("0", "1"):
        raise Fail(f"DELETE_REMOVED must be 0 or 1, not {delete!r}")
    return {
        "api": url + "/api",
        "key": env["IMMICH_API_KEY"],
        "library": env["LIBRARY_ID"],
        # The receiver writes resolved paths into batch lists
        "host_root": os.path.realpath(host_root),
        "container_root": posixpath.normpath(env["PHOTO_ROOT_CONTAINER"]),
        "album": env.get("RAW_ALBUM_NAME") or "Fuji RAW",
        "tag": env.get("CAMERA_TAG") or None,
        "tag_prefix": env.get("CAMERA_TAG_PREFIX") or "Camera/",
        "session_model": (env.get("FUJI_CAMERA_MODEL") or "").strip(),
        "mode": mode,
        "timeout": number(env, "SCAN_TIMEOUT", 900),
        "delete": delete == "1",
        "delete_limit": number(env, "DELETE_LIMIT", 50, int),
        "state_dir": env.get("FUJI_STATE_DIR") or "/var/lib/fuji-autosave",
    }


class Immich:
    def __init__(self, cfg):
        self.api = cfg["api"]
        self.key = cfg["key"]

    def call(self, method, path, body=None):
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.api + path, data=data, method=method)
        req.add_header("x-api-key", self.key)
        req.add_header("Accept", "application/json")
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            raise Fail(f"{method} {path}: HTTP {e.code} {detail}") from None
        except (urllib.error.URLError, OSError) as e:
            raise Fail(f"{method} {path}: {e}") from None
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            raise Fail(f"{method} {path}: response is not JSON (wrong IMMICH_URL?)") from None

    def require_version(self):
        v = self.call("GET", "/server/version")
        version = (v["major"], v["minor"], v["patch"])
        if version < MIN_VERSION:
            raise Fail("Immich %d.%d.%d is too old; this hook needs %d.%d or newer" % (version + MIN_VERSION[:2]))
        return version

    def assets(self, library, with_exif=False, live=True, **conditions):
        """Assets of the library matching the structured search filter
        `conditions` (Immich >= 3.2; the flat search fields go away in v4).
        live=False also returns trashed, offline and locked ones."""
        base = {"libraryId": {"eq": library}}
        if live:
            # The structured search returns trashed and the owner's locked
            # assets unless told otherwise
            base.update(trashedAt={"eq": None}, isOffline={"eq": False},
                        visibility={"in": ["timeline", "archive"]})
        body = {"filter": dict(base, **conditions), "size": PAGE_SIZE}
        if with_exif:
            body["withExif"] = True  # a left join: assets without EXIF yet come back with exifInfo null
        items = []
        while True:
            res = self.call("POST", "/search/metadata", body)["assets"]
            items.extend(res["items"])
            if not res.get("nextCursor"):
                return items
            body["cursor"] = res["nextCursor"]


class State:
    """$FUJI_STATE_DIR/library.json: {"assets": {container path: {"id": asset id,
    "done": [steps], "pair": {field: value}}}}. A path is recorded once Immich
    has an asset for it. Steps are "stack", "archive", and "tag:<tag or prefix*>"
    and "album:<name>", so a changed CAMERA_TAG(_PREFIX) or RAW_ALBUM_NAME
    applies once to everything. "pair" (on a pair's JPEG) holds the rating and
    favorite last made the same on both files."""

    def __init__(self, cfg):
        self.path = os.path.join(cfg["state_dir"], "library.json")
        try:
            with open(self.path) as f:
                self.assets = json.load(f)["assets"]
        except FileNotFoundError:
            self.assets = {}
        except (ValueError, KeyError, TypeError) as e:
            raise Fail(f"{self.path} is unreadable ({e}); move it away to start over") from None

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"assets": self.assets}, f, indent=0, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.rename(tmp, self.path)

    def see(self, a):
        """Record a live asset; a new asset at a known path starts over."""
        e = self.assets.get(a["originalPath"])
        if e is None or e["id"] != a["id"]:
            self.assets[a["originalPath"]] = {"id": a["id"], "done": []}

    def done(self, a, step):
        return step in self.assets[a["originalPath"]]["done"]

    def mark(self, a, step):
        if not self.done(a, step):
            self.assets[a["originalPath"]]["done"].append(step)


def chunks(ids):
    ids = list(ids)
    for i in range(0, len(ids), CHUNK):
        yield ids[i:i + CHUNK]


def kind(path):
    ext = posixpath.splitext(path)[1].lower()
    return "jpeg" if ext in JPEG_EXTS else "raw" if ext in RAW_EXTS else None


def pair_key(path):
    # Pairs share a stem within one day folder (counter rollover is per day)
    d, name = posixpath.split(path)
    return d, posixpath.splitext(name)[0].upper()


# Pending batches

def read_list(cfg, list_path):
    """Container paths of the files in a batch list that still exist."""
    paths = []
    prefix = cfg["host_root"] + os.sep
    with open(list_path) as f:
        for line in f:
            p = os.path.normpath(line.rstrip("\n")) if line.strip() else None
            if p is None or not os.path.isfile(p):
                continue
            if not p.startswith(prefix):
                log(f"{p} is outside PHOTO_ROOT_HOST {cfg['host_root']}, ignoring")
                continue
            rel = p[len(prefix):].replace(os.sep, "/")
            paths.append(posixpath.join(cfg["container_root"], rel))
    return paths


def load_batches(cfg):
    """{list path: [container paths]} for queued batch lists, minus vanished files."""
    return {p: read_list(cfg, p)
            for p in sorted(glob.glob(os.path.join(cfg["state_dir"], "batches", "*.list")))}


def host_path(cfg, container_path):
    rel = container_path[len(cfg["container_root"]) + 1:]
    return os.path.join(cfg["host_root"], *rel.split("/"))


def same_shot(cfg, jpg, raf):
    """JPEG and RAF of one shot share the capture time the receiver stamps as
    mtime; a reused file name (counter reset, second card) does not."""
    try:
        a = os.stat(host_path(cfg, jpg["originalPath"])).st_mtime
        b = os.stat(host_path(cfg, raf["originalPath"])).st_mtime
    except OSError:
        return True  # can't tell from here; trust the name
    return abs(a - b) <= 2


# Deletions

def remove_deleted(immich, cfg, state):
    """Delete the files of recorded assets that Immich no longer has; return how many."""
    root = cfg["container_root"] + "/"
    # Trashed, offline and locked assets count as present
    present = {a["originalPath"]: a["id"]
               for a in immich.assets(cfg["library"], live=False, originalPath={"startsWith": root})}
    if state.assets and not present:
        raise Fail(f"Immich lists no assets in the library, but {len(state.assets)} are recorded; "
                   "not deleting anything (wrong LIBRARY_ID, or Immich was reset?)")
    for p in [p for p in state.assets if not p.startswith(root)]:
        del state.assets[p]  # recorded under another PHOTO_ROOT_CONTAINER
    gone = [p for p, e in state.assets.items() if present.get(p) != e["id"]]
    on_disk = [p for p in gone if os.path.isfile(host_path(cfg, p))]
    for p in gone:
        if p not in on_disk:
            del state.assets[p]  # already gone from disk too
    if not on_disk:
        return 0
    if not cfg["delete"]:
        log(f"{len(on_disk)} file(s) deleted in Immich are still on disk and will be "
            "imported again (DELETE_REMOVED=0)")
        for p in on_disk:
            del state.assets[p]
        return 0
    if len(on_disk) > cfg["delete_limit"] or (len(on_disk) > 10 and len(on_disk) > len(state.assets) / 2):
        sample = ", ".join(on_disk[:5])
        raise Fail(f"{len(on_disk)} of {len(state.assets)} recorded file(s) are no longer in Immich "
                   f"(e.g. {sample}); not deleting that many. If they really were deleted in "
                   "Immich, rerun once with a higher DELETE_LIMIT; or set DELETE_REMOVED=0")
    for p in on_disk:
        hp = host_path(cfg, p)
        os.unlink(hp)
        if os.path.isfile(hp + ".xmp"):
            os.unlink(hp + ".xmp")  # darktable's sidecar
        del state.assets[p]
        log(f"deleted {hp} (deleted in Immich)")
    state.save()
    return len(on_disk)


def wait_for_assets(immich, cfg, wanted):
    """Poll until every container path in `wanted` has an asset; return the missing ones."""
    missing = set(wanted)
    folders = sorted({posixpath.dirname(p) + "/" for p in missing})
    deadline = time.monotonic() + cfg["timeout"]
    delay = 2.0
    while True:
        for folder in folders:
            # startsWith is a case-insensitive LIKE (_ and % are wildcards); compare exactly here
            # Any asset counts as found, even one trashed in Immich since:
            # otherwise its batch would never be retired
            for a in immich.assets(cfg["library"], live=False, originalPath={"startsWith": folder}):
                missing.discard(a["originalPath"])
        if not missing:
            return missing
        left = deadline - time.monotonic()
        if left <= 0:
            return missing
        folders = sorted({posixpath.dirname(p) + "/" for p in missing})
        time.sleep(min(delay, left))
        delay = min(delay * 2, 30.0)


# Reconcile the whole library, each step once per file

def add_all(immich, path, ids):
    """PUT a bulk-ids endpoint in chunks; return (newly added, ids now members)."""
    added, ok = 0, set()
    for chunk in chunks(ids):
        for r in immich.call("PUT", path, {"ids": chunk}):
            if r.get("success"):
                added += 1
                ok.add(r["id"])
            elif r.get("error") == "duplicate":
                ok.add(r["id"])
            else:
                log(f"{path}: asset {r.get('id')}: {r.get('error')} {r.get('errorMessage', '')}".rstrip())
    return added, ok


def tag_assets(immich, cfg, state, assets, session_paths):
    """Tag assets not tagged before; return (newly tagged, model unknown)."""
    step = "tag:" + (cfg["tag"] or cfg["tag_prefix"] + "*")
    todo = [a for a in assets if not state.done(a, step)]
    if not todo:
        return 0, 0
    lib = cfg["library"]
    if cfg["tag"]:
        is_camera_tag = lambda value: value == cfg["tag"]
    else:
        is_camera_tag = lambda value: value.startswith(cfg["tag_prefix"])
    tagged = set()
    for t in immich.call("GET", "/tags"):
        if is_camera_tag(t["value"]):
            tagged.update(a["id"] for a in immich.assets(lib, tagIds={"any": [t["id"]]}))

    wanted = {}  # tag value -> assets
    unknown = 0
    for a in todo:
        if a["id"] in tagged:
            state.mark(a, step)
            continue
        if cfg["tag"]:
            wanted.setdefault(cfg["tag"], []).append(a)
            continue
        # EXIF first; the session's model only describes this session's
        # files, not older queued batches (which may come from another body)
        model = ((a.get("exifInfo") or {}).get("model") or "").strip()
        if not model and a["originalPath"] in session_paths:
            model = cfg["session_model"]
        if not model:
            unknown += 1
            continue
        wanted.setdefault(cfg["tag_prefix"] + model.replace("/", "-"), []).append(a)
    if not wanted:
        return 0, unknown

    ids = {t["value"]: t["id"] for t in immich.call("PUT", "/tags", {"tags": sorted(wanted)})}
    added = 0
    for value, members in sorted(wanted.items()):
        if value not in ids:
            raise Fail(f"tag upsert did not return {value!r}")
        n, ok = add_all(immich, f"/tags/{ids[value]}/assets", [a["id"] for a in members])
        added += n
        for a in members:
            if a["id"] in ok:
                state.mark(a, step)
        log(f"tag {value!r}: {len(members)} asset(s)")
    return added, unknown


def sync_pairs(immich, state, pairs):
    """Give both files of each pair the same rating and favorite; return how many
    assets were changed."""
    fields = {
        # Immich 3 has no rating 0: null is unrated
        "rating": lambda a: (a["exifInfo"].get("rating") or None) if a.get("exifInfo") else None,
        "isFavorite": lambda a: bool(a.get("isFavorite")),
    }
    updates = {}  # (field, value) -> asset ids
    for jpg, raf in pairs:
        if not (jpg.get("exifInfo") and raf.get("exifInfo")):
            continue  # metadata not read yet, so the rating isn't known
        synced = state.assets[jpg["originalPath"]].setdefault("pair", {})
        for field, get in fields.items():
            j, r = get(jpg), get(raf)
            if j != r:
                last = synced.get(field, "unknown")
                if last == "unknown":
                    jpg_wins = j not in (None, False) or r in (None, False)
                else:
                    jpg_wins = j != last
                value, target = (j, raf) if jpg_wins else (r, jpg)
                updates.setdefault((field, value), []).append(target["id"])
                j = value
            synced[field] = j
    for (field, value), ids in updates.items():
        for chunk in chunks(ids):
            immich.call("PUT", "/assets", {"ids": chunk, field: value})
    return sum(len(ids) for ids in updates.values())


def ensure_album(immich, name):
    for a in immich.call("GET", "/albums?isOwned=true"):
        if a["albumName"] == name:
            return a["id"], False
    return immich.call("POST", "/albums", {"albumName": name})["id"], True


def reconcile(immich, cfg, state, new_paths, session_paths, quiet=False):
    root = cfg["container_root"] + "/"
    assets = [a for a in immich.assets(cfg["library"], with_exif=True, originalPath={"startsWith": root})
              if a["originalPath"].startswith(root)]
    for a in assets:
        state.see(a)
    by_path = {a["originalPath"]: a for a in assets}
    stats = {"assets": len(assets)}

    stats["tagged"], unknown = tag_assets(immich, cfg, state, assets, session_paths)
    if unknown and not quiet:
        log(f"{unknown} asset(s) not tagged yet: Immich has no camera model for them; a later run will")

    # Pair JPEG and RAF by folder + stem
    groups = {}
    for a in assets:
        k = kind(a["originalPath"])
        if k:
            groups.setdefault(pair_key(a["originalPath"]), {}).setdefault(k, []).append(a)
    pairs = []
    for g in groups.values():
        if len(g.get("jpeg", [])) == 1 and len(g.get("raw", [])) == 1:
            jpg, raf = g["jpeg"][0], g["raw"][0]
            if same_shot(cfg, jpg, raf):
                pairs.append((jpg, raf))
            elif jpg["originalPath"] in new_paths or raf["originalPath"] in new_paths:
                log(f"not pairing {jpg['originalPath']} with {raf['originalPath']}: capture times differ")

    stats["stacked"] = stats["archived"] = 0
    if cfg["mode"] == "stack":
        todo = [(j, r) for j, r in pairs if not (state.done(j, "stack") and state.done(r, "stack"))]
        if todo:
            stacked = {s_asset["id"] for s in immich.call("GET", "/stacks") for s_asset in s.get("assets", [])}
        for jpg, raf in todo:
            if jpg["id"] not in stacked and raf["id"] not in stacked:
                # The first ID becomes the cover
                immich.call("POST", "/stacks", {"assetIds": [jpg["id"], raf["id"]]})
                stats["stacked"] += 1
            state.mark(jpg, "stack")
            state.mark(raf, "stack")
    else:
        todo = [raf for _, raf in pairs if not state.done(raf, "archive")]
        to_archive = [raf["id"] for raf in todo if raf.get("visibility") == "timeline"]
        for chunk in chunks(to_archive):
            immich.call("PUT", "/assets", {"ids": chunk, "visibility": "archive"})
        stats["archived"] = len(to_archive)
        for raf in todo:
            state.mark(raf, "archive")

    # Each RAF, paired or not, goes into the RAW album once
    album_step = "album:" + cfg["album"]
    raws = [a for a in assets if kind(a["originalPath"]) == "raw" and not state.done(a, album_step)]
    stats["album"] = 0
    if raws:
        album_id, created = ensure_album(immich, cfg["album"])
        if created:
            log(f"created album {cfg['album']!r}")
        stats["album"], ok = add_all(immich, f"/albums/{album_id}/assets", [a["id"] for a in raws])
        for a in raws:
            if a["id"] in ok:
                state.mark(a, album_step)

    stats["pair_synced"] = sync_pairs(immich, state, pairs)

    # Unpaired files among this run's new ones
    paired = {a["originalPath"] for p in pairs for a in p}
    stats["unpaired"] = sorted(p for p in new_paths if p in by_path and kind(p) and p not in paired)
    return stats


def check(immich, cfg):
    log("Immich %d.%d.%d" % immich.require_version())
    lib = immich.call("GET", f"/libraries/{cfg['library']}")
    log(f"library {lib.get('name')!r}, import paths {lib.get('importPaths')}")
    paths = [posixpath.normpath(p) for p in lib.get("importPaths", [])]
    if cfg["container_root"] not in paths:
        raise Fail(f"PHOTO_ROOT_CONTAINER {cfg['container_root']} is not an import path of this library")
    if not os.path.isdir(cfg["host_root"]):
        raise Fail(f"PHOTO_ROOT_HOST {cfg['host_root']} is not a directory")
    n = len(immich.assets(cfg["library"]))
    log(f"ok: {n} asset(s) in the library, RAW_MODE={cfg['mode']}, "
        f"DELETE_REMOVED={int(cfg['delete'])} (limit {cfg['delete_limit']})")


def run(cfg):
    immich = Immich(cfg)
    if "--check" in sys.argv[1:]:
        check(immich, cfg)
        return 0
    if "--sync" in sys.argv[1:]:
        immich.require_version()
        state = State(cfg)
        deleted = remove_deleted(immich, cfg, state)
        try:
            stats = reconcile(immich, cfg, state, set(), set(), quiet=True)
        finally:
            state.save()
        changes = {"tagged": stats["tagged"], "stacked": stats["stacked"], "archived": stats["archived"],
                   "added to the RAW album": stats["album"], "pair rating/favorite(s) copied": stats["pair_synced"]}
        changes = ", ".join(f"{n} {what}" for what, n in changes.items() if n)
        if changes:
            log(f"sync: {changes}")
        return 0

    batches = load_batches(cfg)
    wanted = sorted({p for paths in batches.values() for p in paths})
    # The batch list the receiver started this run for (absent when run by hand)
    this_list = sys.argv[1] if len(sys.argv) > 1 else None
    session_paths = set()
    if this_list:
        for list_path, paths in batches.items():
            if os.path.realpath(list_path) == os.path.realpath(this_list):
                session_paths = set(paths)
    for list_path, paths in batches.items():
        if not paths:
            os.unlink(list_path)

    immich.require_version()
    state = State(cfg)
    # Before the scan, which would import them again
    deleted = remove_deleted(immich, cfg, state)

    immich.call("POST", f"/libraries/{cfg['library']}/scan")
    log(f"scan started; waiting for {len(wanted)} file(s)")
    missing = wait_for_assets(immich, cfg, wanted) if wanted else set()
    for p in sorted(missing):
        log(f"not in Immich yet: {p}")

    try:
        stats = reconcile(immich, cfg, state, set(wanted) - missing, session_paths)
    finally:
        state.save()  # keep what was done, even if a later step failed

    for list_path, paths in batches.items():
        if paths and not missing.intersection(paths):
            os.unlink(list_path)

    raw_line = (f"{stats['stacked']} pair(s) stacked" if cfg["mode"] == "stack"
                else f"{stats['archived']} paired RAF(s) archived")
    log(f"done: {len(wanted) - len(missing)} new file(s) found, {len(missing)} still missing; "
        f"{stats['tagged']} tagged, {raw_line}, {stats['album']} RAF(s) added to {cfg['album']!r}, "
        f"{stats['pair_synced']} pair rating/favorite(s) copied, {deleted} deleted ({stats['assets']} asset(s) in the library)")
    for p in stats["unpaired"]:
        log(f"unpaired: {p}")
    return 1 if missing else 0


def main():
    background = "--sync" in sys.argv[1:]
    try:
        cfg = config()
        os.makedirs(cfg["state_dir"], exist_ok=True)
        # One hook at a time; a later run waits, then picks up whatever is still queued
        with open(os.path.join(cfg["state_dir"], "hook.lock"), "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | (fcntl.LOCK_NB if background else 0))
            except BlockingIOError:
                return 0  # another run is going and does the same
            return run(cfg)
    except Fail as e:
        log(f"error: {e}" + ("" if background else "; pending batches stay queued"))
        return 1


if __name__ == "__main__":
    sys.exit(main())
