#!/usr/bin/env python3
"""Post-batch hook for fuji-autosave-receiver: Immich external library flow.

The receiver writes straight into the external library root
(PHOTO_ROOT_HOST, e.g. /fuji/YYYY/YYYY-MM-DD/DSCF1234.RAF). This hook:

  1. asks Immich to scan the library,
  2. waits until every file of the pending batches has an asset,
  3. tags every library asset with its camera, "Camera/<model>",
  4. stacks each JPEG+RAF pair (JPEG as cover), or with RAW_MODE=archive
     archives the paired RAF instead,
  5. adds every RAF to the RAW_ALBUM_NAME album,
  6. logs a summary.

Steps 3-5 run over the whole library, so anything an earlier run missed
(scan timeout, Immich down) is caught up. Everything is safe to repeat. A batch
list stays queued in $FUJI_STATE_DIR/batches/ until all its files were found.
Files are never moved, renamed or deleted.

Settings come from the environment and from $FUJI_ENV_FILE
(default /etc/fuji-autosave/env; see packaging/fuji-autosave.env.example):
  IMMICH_URL            e.g. http://immich.lan:2283 (a trailing /api is fine)
  IMMICH_API_KEY        API key of the library's owner
  LIBRARY_ID            external library UUID
  PHOTO_ROOT_HOST       library root as this hook sees it (default $FUJI_INBOX,
                        else /fuji)
  PHOTO_ROOT_CONTAINER  the same root as Immich sees it (e.g. /mnt/fuji)
  RAW_ALBUM_NAME        default "Fuji RAW"
  CAMERA_TAG_PREFIX     default "Camera/"; the tag is prefix + camera model,
                        taken from the asset's EXIF Model, or for files of
                        this batch whose EXIF Immich hasn't read yet, from the
                        model the camera reported (FUJI_CAMERA_MODEL)
  CAMERA_TAG            one fixed tag for every asset instead (optional)
  RAW_MODE              stack (default) or archive
  SCAN_TIMEOUT          seconds to wait for new assets (default 900)

Set by the receiver: FUJI_STATE_DIR, FUJI_INBOX, FUJI_BATCH_*, FUJI_CAMERA_*.
Run it by hand as the service user to retry pending batches, or with --check
to test the settings and the API key.
"""
import fcntl
import glob
import json
import os
import posixpath
import sys
import time
import urllib.error
import urllib.request

JPEG_EXTS = {".jpg", ".jpeg"}
RAW_EXTS = {".raf"}
PAGE_SIZE = 1000
CHUNK = 500
MIN_VERSION = (3, 2, 0)  # structured search filters and cursors


def log(msg):
    print(f"immich-hook: {msg}", file=sys.stderr, flush=True)


class Fail(Exception):
    pass


def load_env_file(path):
    """KEY=value lines as written for /bin/sh; values already in os.environ win."""
    try:
        f = open(path)
    except OSError:
        return
    with f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            if key.startswith("export "):
                key = key[7:].strip()
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            elif " #" in value:
                # As in sh: an unquoted " #" starts a comment
                value = value.split(" #", 1)[0].rstrip()
            os.environ.setdefault(key, value)


def config():
    load_env_file(os.environ.get("FUJI_ENV_FILE", "/etc/fuji-autosave/env"))
    env = os.environ
    missing = [k for k in ("IMMICH_URL", "IMMICH_API_KEY", "LIBRARY_ID", "PHOTO_ROOT_CONTAINER") if not env.get(k)]
    host_root = env.get("PHOTO_ROOT_HOST") or env.get("FUJI_INBOX") or "/fuji"
    if missing:
        raise Fail("not set: " + ", ".join(missing))
    url = env["IMMICH_URL"].rstrip("/")
    if url.endswith("/api"):
        url = url[:-4]
    mode = env.get("RAW_MODE", "stack")
    if mode not in ("stack", "archive"):
        raise Fail(f"RAW_MODE must be stack or archive, not {mode!r}")
    try:
        timeout = float(env.get("SCAN_TIMEOUT") or 900)
    except ValueError:
        raise Fail(f"SCAN_TIMEOUT must be a number of seconds, not {env['SCAN_TIMEOUT']!r}") from None
    return {
        "api": url + "/api",
        "key": env["IMMICH_API_KEY"],
        "library": env["LIBRARY_ID"],
        # The receiver writes resolved paths into batch lists
        "host_root": os.path.realpath(host_root),
        "container_root": posixpath.normpath(env["PHOTO_ROOT_CONTAINER"]),
        "album": env.get("RAW_ALBUM_NAME") or "Fuji RAW",
        "tag": env.get("CAMERA_TAG") or None,
        "tag_prefix": env.get("CAMERA_TAG_PREFIX") or "Camera/",
        "session_model": (env.get("FUJI_CAMERA_MODEL") or "").strip(),
        "mode": mode,
        "timeout": timeout,
        "state_dir": env.get("FUJI_STATE_DIR") or "/var/lib/fuji-autosave",
    }


class Immich:
    def __init__(self, cfg):
        self.api = cfg["api"]
        self.key = cfg["key"]

    def call(self, method, path, body=None):
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.api + path, data=data, method=method)
        req.add_header("x-api-key", self.key)
        req.add_header("Accept", "application/json")
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            raise Fail(f"{method} {path}: HTTP {e.code} {detail}") from None
        except (urllib.error.URLError, OSError) as e:
            raise Fail(f"{method} {path}: {e}") from None
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            raise Fail(f"{method} {path}: response is not JSON (wrong IMMICH_URL?)") from None

    def require_version(self):
        v = self.call("GET", "/server/version")
        version = (v["major"], v["minor"], v["patch"])
        if version < MIN_VERSION:
            raise Fail("Immich %d.%d.%d is too old; this hook needs %d.%d or newer" % (version + MIN_VERSION[:2]))
        return version

    def assets(self, library, with_exif=False, live=True, **conditions):
        """Assets of the library matching the structured search filter
        `conditions` (Immich >= 3.2; the flat search fields go away in v4).
        live=False also returns trashed, offline and locked ones."""
        base = {"libraryId": {"eq": library}}
        if live:
            # The structured search returns trashed and the owner's locked
            # assets unless told otherwise
            base.update(trashedAt={"eq": None}, isOffline={"eq": False},
                        visibility={"in": ["timeline", "archive"]})
        body = {"filter": dict(base, **conditions), "size": PAGE_SIZE}
        if with_exif:
            body["withExif"] = True  # a left join: assets without EXIF yet come back with exifInfo null
        items = []
        while True:
            res = self.call("POST", "/search/metadata", body)["assets"]
            items.extend(res["items"])
            if not res.get("nextCursor"):
                return items
            body["cursor"] = res["nextCursor"]


def chunks(ids):
    ids = list(ids)
    for i in range(0, len(ids), CHUNK):
        yield ids[i:i + CHUNK]


def kind(path):
    ext = posixpath.splitext(path)[1].lower()
    return "jpeg" if ext in JPEG_EXTS else "raw" if ext in RAW_EXTS else None


def pair_key(path):
    # Pairs share a stem within one day folder (counter rollover is per day)
    d, name = posixpath.split(path)
    return d, posixpath.splitext(name)[0].upper()


# Pending batches

def read_list(cfg, list_path):
    """Container paths of the files in a batch list that still exist."""
    paths = []
    prefix = cfg["host_root"] + os.sep
    with open(list_path) as f:
        for line in f:
            p = os.path.normpath(line.rstrip("\n")) if line.strip() else None
            if p is None or not os.path.isfile(p):
                continue
            if not p.startswith(prefix):
                log(f"{p} is outside PHOTO_ROOT_HOST {cfg['host_root']}, ignoring")
                continue
            rel = p[len(prefix):].replace(os.sep, "/")
            paths.append(posixpath.join(cfg["container_root"], rel))
    return paths


def load_batches(cfg):
    """{list path: [container paths]} for queued batch lists, minus vanished files."""
    return {p: read_list(cfg, p)
            for p in sorted(glob.glob(os.path.join(cfg["state_dir"], "batches", "*.list")))}


def host_path(cfg, container_path):
    rel = container_path[len(cfg["container_root"]) + 1:]
    return os.path.join(cfg["host_root"], *rel.split("/"))


def same_shot(cfg, jpg, raf):
    """JPEG and RAF of one shot share the capture time the receiver stamps as
    mtime; a reused file name (counter reset, second card) does not."""
    try:
        a = os.stat(host_path(cfg, jpg["originalPath"])).st_mtime
        b = os.stat(host_path(cfg, raf["originalPath"])).st_mtime
    except OSError:
        return True  # can't tell from here; trust the name
    return abs(a - b) <= 2


def wait_for_assets(immich, cfg, wanted):
    """Poll until every container path in `wanted` has an asset; return the missing ones."""
    missing = set(wanted)
    folders = sorted({posixpath.dirname(p) + "/" for p in missing})
    deadline = time.monotonic() + cfg["timeout"]
    delay = 2.0
    while True:
        for folder in folders:
            # startsWith is a case-insensitive LIKE (_ and % are wildcards); compare exactly here
            # Any asset counts as found, even one trashed in Immich since:
            # otherwise its batch would never be retired
            for a in immich.assets(cfg["library"], live=False, originalPath={"startsWith": folder}):
                missing.discard(a["originalPath"])
        if not missing:
            return missing
        left = deadline - time.monotonic()
        if left <= 0:
            return missing
        folders = sorted({posixpath.dirname(p) + "/" for p in missing})
        time.sleep(min(delay, left))
        delay = min(delay * 2, 30.0)


# Reconcile the whole library

def tag_assets(immich, cfg, assets, session_paths):
    """Tag every untagged asset with its camera; return (newly tagged, model unknown)."""
    lib = cfg["library"]
    if cfg["tag"]:
        is_camera_tag = lambda value: value == cfg["tag"]
    else:
        is_camera_tag = lambda value: value.startswith(cfg["tag_prefix"])
    tagged = set()
    for t in immich.call("GET", "/tags"):
        if is_camera_tag(t["value"]):
            tagged.update(a["id"] for a in immich.assets(lib, tagIds={"any": [t["id"]]}))
    todo = [a for a in assets if a["id"] not in tagged]
    if not todo:
        return 0, 0

    wanted = {}  # tag value -> asset ids
    unknown = 0
    if cfg["tag"]:
        wanted[cfg["tag"]] = [a["id"] for a in todo]
    else:
        for a in todo:
            # EXIF first; the session's model only describes this session's
            # files, not older queued batches (which may come from another body)
            model = ((a.get("exifInfo") or {}).get("model") or "").strip()
            if not model and a["originalPath"] in session_paths:
                model = cfg["session_model"]
            if not model:
                unknown += 1
                continue
            wanted.setdefault(cfg["tag_prefix"] + model.replace("/", "-"), []).append(a["id"])
    if not wanted:
        return 0, unknown

    ids = {t["value"]: t["id"] for t in immich.call("PUT", "/tags", {"tags": sorted(wanted)})}
    added = 0
    for value, asset_ids in sorted(wanted.items()):
        if value not in ids:
            raise Fail(f"tag upsert did not return {value!r}")
        added += add_all(immich, f"/tags/{ids[value]}/assets", asset_ids)
        log(f"tag {value!r}: {len(asset_ids)} asset(s)")
    return added, unknown


def ensure_album(immich, name):
    for a in immich.call("GET", "/albums?isOwned=true"):
        if a["albumName"] == name:
            return a["id"], False
    return immich.call("POST", "/albums", {"albumName": name})["id"], True


def add_all(immich, path, ids):
    """PUT a bulk-ids endpoint in chunks; count new members (duplicates are fine)."""
    added = 0
    for chunk in chunks(ids):
        for r in immich.call("PUT", path, {"ids": chunk}):
            if r.get("success"):
                added += 1
            elif r.get("error") != "duplicate":
                log(f"{path}: asset {r.get('id')}: {r.get('error')} {r.get('errorMessage', '')}".rstrip())
    return added


def reconcile(immich, cfg, new_paths, session_paths):
    root = cfg["container_root"] + "/"
    assets = [a for a in immich.assets(cfg["library"], with_exif=True, originalPath={"startsWith": root})
              if a["originalPath"].startswith(root)]
    by_path = {a["originalPath"]: a for a in assets}
    stats = {"assets": len(assets)}

    # Tag every asset with the camera it came from
    stats["tagged"], unknown = tag_assets(immich, cfg, assets, session_paths)
    if unknown:
        log(f"{unknown} asset(s) not tagged yet: Immich has no camera model for them; a later run will")

    # Pair JPEG and RAF by folder + stem
    groups = {}
    for a in assets:
        k = kind(a["originalPath"])
        if k:
            groups.setdefault(pair_key(a["originalPath"]), {}).setdefault(k, []).append(a)
    pairs = []
    for g in groups.values():
        if len(g.get("jpeg", [])) == 1 and len(g.get("raw", [])) == 1:
            jpg, raf = g["jpeg"][0], g["raw"][0]
            if same_shot(cfg, jpg, raf):
                pairs.append((jpg, raf))
            elif jpg["originalPath"] in new_paths or raf["originalPath"] in new_paths:
                log(f"not pairing {jpg['originalPath']} with {raf['originalPath']}: capture times differ")

    stats["stacked"] = stats["archived"] = 0
    if cfg["mode"] == "stack":
        stacked = {s_asset["id"] for s in immich.call("GET", "/stacks") for s_asset in s.get("assets", [])}
        for jpg, raf in pairs:
            if jpg["id"] in stacked or raf["id"] in stacked:
                continue
            # The first ID becomes the cover
            immich.call("POST", "/stacks", {"assetIds": [jpg["id"], raf["id"]]})
            stats["stacked"] += 1
    else:
        to_archive = [raf["id"] for _, raf in pairs if raf.get("visibility") == "timeline"]
        for chunk in chunks(to_archive):
            immich.call("PUT", "/assets", {"ids": chunk, "visibility": "archive"})
        stats["archived"] = len(to_archive)

    # Every RAF, paired or not, goes into the RAW album
    album_id, created = ensure_album(immich, cfg["album"])
    if created:
        log(f"created album {cfg['album']!r}")
    in_album = {a["id"] for a in immich.assets(cfg["library"], albumIds={"any": [album_id]})}
    raws = [a["id"] for a in assets if kind(a["originalPath"]) == "raw" and a["id"] not in in_album]
    stats["album"] = add_all(immich, f"/albums/{album_id}/assets", raws)

    # Unpaired files among this run's new ones
    paired = {a["originalPath"] for p in pairs for a in p}
    stats["unpaired"] = sorted(p for p in new_paths if p in by_path and kind(p) and p not in paired)
    return stats


def check(immich, cfg):
    log("Immich %d.%d.%d" % immich.require_version())
    lib = immich.call("GET", f"/libraries/{cfg['library']}")
    log(f"library {lib.get('name')!r}, import paths {lib.get('importPaths')}")
    paths = [posixpath.normpath(p) for p in lib.get("importPaths", [])]
    if cfg["container_root"] not in paths:
        raise Fail(f"PHOTO_ROOT_CONTAINER {cfg['container_root']} is not an import path of this library")
    if not os.path.isdir(cfg["host_root"]):
        raise Fail(f"PHOTO_ROOT_HOST {cfg['host_root']} is not a directory")
    n = len(immich.assets(cfg["library"]))
    log(f"ok: {n} asset(s) in the library, RAW_MODE={cfg['mode']}")


def run(cfg):
    immich = Immich(cfg)
    if "--check" in sys.argv[1:]:
        check(immich, cfg)
        return 0

    batches = load_batches(cfg)
    wanted = sorted({p for paths in batches.values() for p in paths})
    # The batch list the receiver started this run for (absent when run by hand)
    this_list = sys.argv[1] if len(sys.argv) > 1 else None
    session_paths = set()
    if this_list:
        for list_path, paths in batches.items():
            if os.path.realpath(list_path) == os.path.realpath(this_list):
                session_paths = set(paths)
    for list_path, paths in batches.items():
        if not paths:
            os.unlink(list_path)

    immich.require_version()
    immich.call("POST", f"/libraries/{cfg['library']}/scan")
    log(f"scan started; waiting for {len(wanted)} file(s)")
    missing = wait_for_assets(immich, cfg, wanted) if wanted else set()
    for p in sorted(missing):
        log(f"not in Immich yet: {p}")

    stats = reconcile(immich, cfg, set(wanted) - missing, session_paths)

    for list_path, paths in batches.items():
        if paths and not missing.intersection(paths):
            os.unlink(list_path)

    raw_line = (f"{stats['stacked']} pair(s) stacked" if cfg["mode"] == "stack"
                else f"{stats['archived']} paired RAF(s) archived")
    log(f"done: {len(wanted) - len(missing)} new file(s) found, {len(missing)} still missing; "
        f"{stats['tagged']} tagged, {raw_line}, {stats['album']} RAF(s) added to {cfg['album']!r} "
        f"({stats['assets']} asset(s) in the library)")
    for p in stats["unpaired"]:
        log(f"unpaired: {p}")
    return 1 if missing else 0


def main():
    try:
        cfg = config()
        os.makedirs(cfg["state_dir"], exist_ok=True)
        # One hook at a time; a later run waits, then picks up whatever is still queued
        with open(os.path.join(cfg["state_dir"], "hook.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return run(cfg)
    except Fail as e:
        log(f"error: {e}; pending batches stay queued")
        return 1


if __name__ == "__main__":
    sys.exit(main())
